{
  "name": "charaktail",
  "private": true,
  "type": "module",
  "description": "charaktail — 캐릭터 설정 뽑기 PWA. 흔들면 섞이고, 빛나면 정해진다.",
  "scripts": {
    "relay": "bunx relay-compiler && bun scripts/print-schema.ts",
    "dev": "bun run relay && bun --bun vite --host",
    "build": "bun run relay && bun run typecheck:tsc && bun --bun vite build",
    "preview": "bun --bun vite preview --host",
    "typecheck": "bun run relay && bun run typecheck:tsc",
    "typecheck:tsc": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun test src",
    "schema": "bun scripts/print-schema.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^20.1.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-relay": "^21.0.1",
    "relay-compiler": "^21.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "packageManager": "bun@1.4.1"
}
