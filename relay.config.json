{
  "src": "./src",
  "schema": "./schema.graphql",
  "language": "typescript",
  "eagerEsModules": true,
  "artifactDirectory": "./src/__generated__",
  "excludes": [
    "**/node_modules/**",
    "**/__generated__/**",
    "**/dist/**"
  ],
  "schemaExtensions": [
    "./src/graph/schema"
  ],
  "featureFlags": {
    "allow_resolver_non_nullable_return_type": {
      "kind": "enabled"
    }
  }
}
